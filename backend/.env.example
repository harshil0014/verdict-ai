PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
VERDICT_OPERATOR_PASSWORD=
# Legacy operator app only. Account mode uses the separate, default-off,
# merchant-authorized bounded policy; this flag does not opt a merchant in.
VERDICT_ALLOW_SANDBOX_ACTIONS=false
VERDICT_APP_MODULE=saas_app:app
VERDICT_AUTH_PEPPER=
VERDICT_PUBLIC_HOST=127.0.0.1:8000
VERDICT_SECURE_COOKIES=false
# Google Search grounding stays off. Free keyless discovery needs no API key.
VERDICT_GOOGLE_SEARCH_ENABLED=false
# Optional restricted first-party test merchant; provision owner binding server-side.
VERDICT_PAYPAL_DEMO_OWNER_ID=
VERDICT_PAYPAL_DEMO_MERCHANT_ID=
# Optional local executable path; Docker installs Tesseract on PATH.
TESSERACT_CMD=

# Internal, precision-gated address proximity tolerance (metres; default 200).
VERDICT_LOCATION_PROXIMITY_METRES=200
